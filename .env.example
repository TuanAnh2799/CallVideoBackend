# Cong HTTP/Socket.io server lang nghe
PORT=4000

# Danh sach origin duoc phep goi socket.io (phan cach boi dau phay), vi du:
# CORS_ORIGIN=*
CORS_ORIGIN=*

# Bi mat de xac thuc token cua client khi "register" (kiem tra JWT/tam theo he thong Hunonic hien tai)
# Neu khong dat, server se chay o che do khong xac thuc (CHI dung khi dev local)
AUTH_SECRET=

# === STUN (mien phi, dung P2P NAT traversal) ===
STUN_URL=stun:stun.l.google.com:19302

# === APNs VoIP Push (PushKit, iOS) - danh thuc app nhan cuoc goi den ke ca khi app da bi kill ===
# Neu de trong 4 bien nay, tinh nang goi khi app bi kill se KHONG hoat dong (van goi binh
# thuong luc app dang mo), server chi bo qua buoc gui push.
# Lay APNS_KEY_ID + tai file .p8 tai: Apple Developer > Certificates, Identifiers & Profiles
# > Keys > tao 1 key moi voi quyen "Apple Push Notifications service (APNs)".
APNS_KEY_PATH=
APNS_KEY_ID=
# Team ID: xem o Apple Developer > Membership
APNS_TEAM_ID=
# Bundle ID cua app (KHONG kem .voip - server tu them "<APNS_BUNDLE_ID>.voip" lam topic)
APNS_BUNDLE_ID=
# false = dung APNs sandbox (build debug tu Xcode). true = production (App Store/TestFlight).
APNS_PRODUCTION=false

# === TURN (coturn tren VPS, dung khi P2P bi chan) ===
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Neu coturn bat static-auth-secret (khuyen nghi, sinh credential tam thoi thay vi fix cung):
# https://github.com/coturn/coturn/blob/master/README.turnserver#L363
TURN_STATIC_AUTH_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=86400
